<%
  var md = function (s) { return (s || "").replace(/\[([^\]]+)\]\(([^)]+)\)/g, "<a href=\"$2\">$1</a>"); };
  var info = function (c) {
    var kw = c.keywords || [];
    var level = kw.indexOf("Doctoral") > -1 ? "doctoral" : kw.indexOf("Graduate") > -1 ? "masters" : kw.some(function (k) { return /^under/i.test(k); }) ? "undergraduate" : "other";
    var term = kw.filter(function (k) { return /^(Fall|Spring|Summer|Winter) \d{4}$|^\d{4}-\d{4}$/.test(k); })[0] || "";
    var oer = kw.indexOf("OER") > -1;
    var tags = kw.filter(function (k) { return k !== "OER" && k !== term && !/^(Doctoral|Graduate|Undergraduate|Undergaduate)$/.test(k); });
    var m = c.title.match(/^((?:Psyc|PSYC|MCHC|SOCY)[^:]*?)\s*(?::|\s-\s)\s*(.*)$/);
    var code = m ? m[1] : "";
    var name = m ? m[2] : c.title;
    var mm = name.match(/^(.*?)\s*\(([^)]+)\)$/);
    var base = mm ? mm[1] : name;
    var mode = mm ? mm[2] : "";
    var placeholder = !c.image || /course_placeholder/.test(c.image);
    return { level: level, term: term, oer: oer, tags: tags, code: code, name: name, base: base, mode: mode, placeholder: placeholder };
  };
  var levelLabel = { undergraduate: "undergraduate", masters: "master’s", doctoral: "doctoral", other: "other" };
  var codeTile = function (code) { return "<div class=\"code-tile\"><span>" + code.replace(/\s+/, "</span><span>") + "</span></div>"; };
%>
<%
  var all = items.map(function (c) { return { c: c, x: info(c) }; });
  var groups = [["undergraduate", "undergraduate", "c-pink"], ["masters", "master’s · Brooklyn College", "c-violet"], ["doctoral", "doctoral · Graduate Center of CUNY", "c-blue"]];
%>
<% groups.forEach(function (g) { var these = all.filter(function (a) { return a.x.level === g[0]; }); if (!these.length) return; %>
<div class="card <%- g[2] %> level-card">
<div class="card-head"><p><span class="card-label">┌─ <%- g[1] %></span><span class="count"><%- these.length %></span></p></div>
<div class="tile-grid">
<% these.forEach(function (a) { var c = a.c, x = a.x; %>
<div class="tile">
<div class="tile-thumb"><% if (x.placeholder) { %><%= codeTile(x.code) %><% } else { %><img src="<%- c.image %>" alt="" loading="lazy"><% } %></div>
<div class="tile-body">
<div class="tcode"><%- x.code %><% if (x.term) { %> · <%- x.term %><% } %></div>
<div class="ttitle"><% if (c.url) { %><a href="<%- c.url %>"><%- x.base %></a><% } else { %><%- x.base %><% } %></div>
<% if (x.mode) { %><div class="tmode"><%- x.mode.toLowerCase() %></div><% } %>
<% if (c.description) { %><div class="tdesc"><%= md(c.description) %></div><% } %>
<div class="ttags"><% if (x.oer) { %><span class="oer">OER</span><% } %><% x.tags.forEach(function (t) { %><span class="lvl"><%- t %></span><% }); %></div>
</div>
</div>
<% }); %>
</div>
</div>
<% }); %>
